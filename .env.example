# Required. Protects the panel: you sign in with this key, and scripts can send it
# as "Authorization: Bearer <key>". Use a long random value, e.g. `openssl rand -hex 32`.
ADMIN_API_KEY=

# Pangram AI detection (https://www.pangram.com)
PANGRAM_API_KEY=

# StealthGPT humanizer (https://www.stealthgpt.ai/stealthapi)
STEALTHGPT_API_KEY=

